{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-migration-on-prem"
		},
		"ls_MySql1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_MySql1'"
		},
		"ls_adls_copy_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_copy'"
		},
		"ls_MySql1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"ls_MySql1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "banking"
		},
		"ls_MySql1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"ls_adls_copy_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saibdp1storage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-migration-on-prem_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_copy_accountKey": {
						"value": "[parameters('ls_adls_copy_accountKey')]"
					},
					"ls_MySql1_password": {
						"value": "[parameters('ls_MySql1_password')]"
					},
					"ls_adls_copy_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_copy_properties_typeProperties_url')]"
					},
					"ls_MySql1_properties_typeProperties_server": {
						"value": "[parameters('ls_MySql1_properties_typeProperties_server')]"
					},
					"ls_MySql1_properties_typeProperties_database": {
						"value": "[parameters('ls_MySql1_properties_typeProperties_database')]"
					},
					"ls_MySql1_properties_typeProperties_username": {
						"value": "[parameters('ls_MySql1_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}